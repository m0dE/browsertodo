# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_ID=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
ANTHROPIC_API_KEY=
# Only when ANTHROPIC_API_KEY is not scoped to a workspace: the workspace id (wrkspc_...) to bill.
# A Worker var, not a secret. Empty: no anthropic-workspace-id header is sent.
ANTHROPIC_WORKSPACE_ID=
# Realtime voice (GET /v1/ai/realtime): an OpenAI API key with access to the realtime models.
# A Worker secret. Empty: realtime voice answers 503 and the extension uses the Standard engine.
OPENAI_API_KEY=
# Optional Worker var: the OpenAI Realtime model (a key of REALTIME_PRICES in apps/api/src/pricing.ts).
# Empty: gpt-realtime-2.1.
REALTIME_MODEL=
DASHBOARD_ORIGIN=
# The API origin setup-stripe points the webhook at (empty: the default account server).
BROWSERTODO_API=
